parameters:
  level: 8
  excludePaths:
    analyse:
      - dependencies
    analyseAndScan:
      - vendor
  scanFiles:
    - cardanopress-ispo.php
  scanDirectories:
    - .cache/wordpress
    - .cache/wordpress-tests-lib
    - dependencies
    - ../cardanopress
  dynamicConstantNames:
    - CP_ISPO_FILE
